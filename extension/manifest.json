{
  "manifest_version": 3,
  "name": "JobCopilot",
  "version": "0.1.0",
  "description": "Pre-fills job applications for your review. You always click Submit yourself.",
  "permissions": ["storage", "notifications"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://internshala.com/*",
        "https://*.internshala.com/*",
        "https://www.naukri.com/*",
        "https://unstop.com/*",
        "https://*.unstop.com/*",
        "https://wellfound.com/*",
        "https://*.wellfound.com/*"
      ],
      "js": ["content/platforms.js", "content/guard.js", "content/filler.js", "content/overlay.js", "content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
